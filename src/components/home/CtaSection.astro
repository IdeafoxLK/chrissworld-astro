---
/**
 * Closing call to action, set over the cargo-ship photograph.
 */
import ArrowRight from '@lucide/astro/icons/arrow-right';
import Phone from '@lucide/astro/icons/phone';
---

<section class="relative isolate overflow-hidden">
    <img
        src="/media/cms/cargo-ship-scaled.webp"
        alt=""
        width="2560"
        height="692"
        loading="lazy"
        class="absolute inset-0 -z-10 h-full w-full object-cover"
    />
    <div class="absolute inset-0 -z-10 bg-gradient-to-r from-navy via-navy/90 to-navy/60"></div>

    <div class="mx-auto max-w-7xl px-6 py-20 sm:py-24 lg:px-8">
        <div class="max-w-2xl">
            <h2 class="text-3xl font-bold text-white sm:text-4xl">Ready to optimise your global flow?</h2>
            <p class="mt-4 text-lg leading-relaxed text-white/70">
                Talk to our team for a custom evaluation of your supply chain: freight, warehousing
                and inland distribution under one agreement.
            </p>

            <div class="mt-9 flex flex-col gap-3 sm:flex-row">
                <a
                    href="/contact-us"
                    class="group inline-flex cursor-pointer items-center justify-center gap-2 rounded-full bg-primary px-7 py-3.5 text-sm font-semibold text-on-primary no-underline shadow-lg transition-colors duration-200 hover:bg-primary-dark"
                >
                    Request a quote
                    <ArrowRight class="h-4 w-4 transition-transform duration-200 group-hover:translate-x-1" />
                </a>
                <a
                    href="tel:+94770023588"
                    class="inline-flex cursor-pointer items-center justify-center gap-2 rounded-full border border-white/25 bg-white/5 px-7 py-3.5 text-sm font-semibold text-white no-underline backdrop-blur-sm transition-colors duration-200 hover:border-white/60 hover:bg-white/10"
                >
                    <Phone class="h-4 w-4" />
                    Speak with an expert
                </a>
            </div>
        </div>
    </div>
</section>
