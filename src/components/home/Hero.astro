---
/**
 * Home hero -- full-bleed navy stage over the brand hero photograph.
 */
import ArrowRight from '@lucide/astro/icons/arrow-right';
import Phone from '@lucide/astro/icons/phone';
import ShieldCheck from '@lucide/astro/icons/shield-check';
import Warehouse from '@lucide/astro/icons/warehouse';
import Globe from '@lucide/astro/icons/globe';
import BadgeCheck from '@lucide/astro/icons/badge-check';

interface Props {
    serviceCount: number;
    facilityCount: number;
}

const { serviceCount, facilityCount } = Astro.props;

const proofPoints = [
    { icon: ShieldCheck, value: '25-35 yrs', label: 'Board-level experience' },
    { icon: Warehouse, value: `${facilityCount}`, label: 'Warehouse facilities' },
    { icon: Globe, value: `${serviceCount}`, label: 'Integrated services' },
    { icon: BadgeCheck, value: 'CSE', label: 'Listed on Empower Board' },
];
---

<section class="relative isolate overflow-hidden bg-navy">
    <img
        src="/media/cms/home-hero-scaled.webp"
        alt=""
        width="2560"
        height="1273"
        loading="eager"
        fetchpriority="high"
        class="absolute inset-0 -z-10 h-full w-full object-cover object-center opacity-45"
    />
    <div class="absolute inset-0 -z-10 bg-gradient-to-br from-navy via-navy/85 to-secondary-dark/60"></div>
    <div
        class="absolute -top-32 -right-24 -z-10 h-[28rem] w-[28rem] rounded-full bg-primary/25 blur-3xl"
        aria-hidden="true"
    >
    </div>

    <div class="mx-auto max-w-7xl px-6 pt-24 pb-16 sm:pt-32 sm:pb-20 lg:px-8">
        <div class="max-w-3xl">
            <p
                class="inline-flex items-center gap-2 rounded-full border border-white/15 bg-white/5 px-4 py-1.5 text-xs font-semibold tracking-wide text-white/80 uppercase backdrop-blur-sm"
            >
                <span class="h-1.5 w-1.5 rounded-full bg-primary"></span>
                Total logistics
            </p>

            <h1 class="mt-6 text-4xl leading-tight font-bold text-white sm:text-5xl lg:text-6xl">
                Unique solutions.
                <span class="block text-primary">Winning partnerships.</span>
            </h1>

            <p class="mt-6 max-w-2xl text-lg leading-relaxed text-white/75">
                Looking for speed, security and flexibility? Chrissworld handles freight forwarding,
                warehousing and project cargo end to end. One partner, one point of accountability,
                from A to Z.
            </p>

            <div class="mt-10 flex flex-col gap-3 sm:flex-row sm:items-center">
                <a
                    href="/contact-us"
                    class="group inline-flex cursor-pointer items-center justify-center gap-2 rounded-full bg-primary px-7 py-3.5 text-sm font-semibold text-on-primary no-underline shadow-lg transition-colors duration-200 hover:bg-primary-dark"
                >
                    Request a quote
                    <ArrowRight class="h-4 w-4 transition-transform duration-200 group-hover:translate-x-1" />
                </a>
                <a
                    href="tel:+94770023588"
                    class="inline-flex cursor-pointer items-center justify-center gap-2 rounded-full border border-white/25 px-7 py-3.5 text-sm font-semibold text-white no-underline transition-colors duration-200 hover:border-white/60 hover:bg-white/10"
                >
                    <Phone class="h-4 w-4" />
                    +94 77 002 3588
                </a>
            </div>
        </div>

        <dl class="mt-16 grid grid-cols-2 gap-x-6 gap-y-8 border-t border-white/10 pt-10 lg:grid-cols-4">
            {
                proofPoints.map((point) => (
                    <div class="flex items-start gap-3">
                        <point.icon class="mt-1 h-5 w-5 shrink-0 text-primary" />
                        <div>
                            <dt class="text-2xl font-bold text-white">{point.value}</dt>
                            <dd class="mt-0.5 text-sm text-white/60">{point.label}</dd>
                        </div>
                    </div>
                ))
            }
        </dl>
    </div>
</section>
