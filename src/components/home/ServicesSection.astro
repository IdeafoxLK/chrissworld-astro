---
/**
 * Services grid -- rendered live from the WordPress `service` post type.
 */
import ArrowUpRight from '@lucide/astro/icons/arrow-up-right';
import Warehouse from '@lucide/astro/icons/warehouse';
import Ship from '@lucide/astro/icons/ship';
import Truck from '@lucide/astro/icons/truck';
import Package from '@lucide/astro/icons/package';
import HardHat from '@lucide/astro/icons/hard-hat';
import Lightbulb from '@lucide/astro/icons/lightbulb';
import Boxes from '@lucide/astro/icons/boxes';
import type { ContentCard } from '@/lib/functions';

interface Props {
    services: ContentCard[];
}

const { services } = Astro.props;

const iconBySlug: Record<string, any> = {
    warehousing: Warehouse,
    'freight-forwarding': Ship,
    'inland-transportation': Truck,
    'value-added-services-vas': Package,
    'project-cargo': HardHat,
    consultancy: Lightbulb,
};
---

<section id="services" class="bg-surface py-20 sm:py-28">
    <div class="mx-auto max-w-7xl px-6 lg:px-8">
        <div class="flex flex-col gap-6 lg:flex-row lg:items-end lg:justify-between">
            <div class="max-w-2xl">
                <p class="text-xs font-semibold tracking-widest text-primary uppercase">What we do</p>
                <h2 class="mt-3 text-3xl font-bold text-content sm:text-4xl">
                    Unique solutions under one roof
                </h2>
                <p class="mt-4 text-lg leading-relaxed text-content-light">
                    Six connected service lines, so your cargo never changes hands between vendors.
                </p>
            </div>
            <a
                href="/services"
                class="inline-flex cursor-pointer items-center gap-2 self-start text-sm font-semibold text-secondary no-underline transition-colors duration-200 hover:text-primary lg:self-auto"
            >
                All services
                <ArrowUpRight class="h-4 w-4" />
            </a>
        </div>

        <div class="mt-14 grid gap-6 sm:grid-cols-2 lg:grid-cols-3">
            {
                services.map((service) => {
                    const Icon = iconBySlug[service.slug] ?? Boxes;
                    return (
                        <a
                            href={`/services/${service.slug}`}
                            class="group relative flex cursor-pointer flex-col overflow-hidden rounded-2xl border border-outline bg-surface no-underline transition-all duration-300 hover:-translate-y-1 hover:border-primary/40 hover:shadow-xl"
                        >
                            {service.image && (
                                <div class="relative h-44 overflow-hidden">
                                    <img
                                        src={service.image}
                                        alt={service.title}
                                        width="1024"
                                        height="576"
                                        loading="lazy"
                                        class="h-full w-full object-cover transition-transform duration-500 group-hover:scale-105"
                                    />
                                    <div class="absolute inset-0 bg-gradient-to-t from-navy/70 to-transparent"></div>
                                </div>
                            )}

                            <div class="flex flex-1 flex-col p-6">
                                <span class="inline-flex h-11 w-11 items-center justify-center rounded-xl bg-primary/10 text-primary transition-colors duration-300 group-hover:bg-primary group-hover:text-on-primary">
                                    <Icon class="h-5 w-5" />
                                </span>
                                <h3 class="mt-5 text-lg font-semibold text-content">{service.title}</h3>
                                <p class="mt-3 flex-1 text-sm leading-relaxed text-content-light">
                                    {service.excerpt}
                                </p>
                                <span class="mt-5 inline-flex items-center gap-1.5 text-sm font-semibold text-secondary transition-colors duration-200 group-hover:text-primary">
                                    Learn more
                                    <ArrowUpRight class="h-4 w-4 transition-transform duration-200 group-hover:translate-x-0.5 group-hover:-translate-y-0.5" />
                                </span>
                            </div>
                        </a>
                    );
                })
            }
        </div>
    </div>
</section>
