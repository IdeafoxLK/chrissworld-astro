---
/**
 * Testimonials.
 *
 * NOTE: the `review` post type exposes only its title over REST -- the quote
 * body and job title live in ACF fields that are not published to the API.
 * These excerpts are mirrored from the live site; move them to WordPress data
 * once "Show in REST API" is enabled on the review field group.
 */
import Quote from '@lucide/astro/icons/quote';

interface Testimonial {
    quote: string;
    name: string;
    role: string;
}

const testimonials: Testimonial[] = [
    {
        quote:
            'Thank you for a very very efficient service. Have been dealing with many freight forwarding agents for the past 8 years and this is the 1st time I did not have...',
        name: 'Jyoti Ekanayake',
        role: 'Managing Director',
    },
    {
        quote:
            'I am really impressed with ChrissWorld warehouse management and they are the best that anyone can ever work with in Sri Lanka...',
        name: 'Dhanesh Jayathilaka',
        role: 'Consultant',
    },
    {
        quote:
            'We have been partnered with Chriss group on warehouse operations for the past five years and we were extremely happy with the flexibility and the...',
        name: 'Shantha Thenuwara',
        role: 'Logistics Manager',
    },
];
---

<section class="relative isolate overflow-hidden bg-navy py-20 sm:py-28">
    <div
        class="absolute -bottom-32 -left-24 -z-10 h-96 w-96 rounded-full bg-secondary/20 blur-3xl"
        aria-hidden="true"
    >
    </div>

    <div class="mx-auto max-w-7xl px-6 lg:px-8">
        <div class="max-w-2xl">
            <p class="text-xs font-semibold tracking-widest text-primary uppercase">Testimonials</p>
            <h2 class="mt-3 text-3xl font-bold text-white sm:text-4xl">
                What partners say after years, not weeks
            </h2>
        </div>

        <div class="mt-14 grid gap-6 lg:grid-cols-3">
            {
                testimonials.map((testimonial) => (
                    <figure class="flex h-full flex-col rounded-2xl border border-white/10 bg-white/5 p-8 backdrop-blur-sm transition-colors duration-300 hover:border-primary/40">
                        <Quote class="h-8 w-8 text-primary/70" />
                        <blockquote class="mt-5 flex-1 text-sm leading-relaxed text-white/80">
                            {testimonial.quote}
                        </blockquote>
                        <figcaption class="mt-7 border-t border-white/10 pt-5">
                            <div class="text-sm font-semibold text-white">{testimonial.name}</div>
                            <div class="mt-0.5 text-xs tracking-wide text-primary uppercase">
                                {testimonial.role}
                            </div>
                        </figcaption>
                    </figure>
                ))
            }
        </div>
    </div>
</section>
