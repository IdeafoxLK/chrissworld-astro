---
/**
 * Chrissworld PLC -- home page.
 *
 * Services and news render from live WordPress data. Hero, about and
 * testimonial copy is inline because the WordPress home page is built in
 * Bricks (empty `content.rendered`) and the review/facility detail fields
 * live in ACF groups that are not published to the REST API yet.
 */
export const prerender = true;

import BaseLayout from '@/layouts/BaseLayout.astro';
import Header from '@/components/Header.astro';
import Footer from '@/components/Footer.astro';
import Hero from '@/components/home/Hero.astro';
import ServicesSection from '@/components/home/ServicesSection.astro';
import AboutSection from '@/components/home/AboutSection.astro';
import FacilitiesSection from '@/components/home/FacilitiesSection.astro';
import TestimonialsSection from '@/components/home/TestimonialsSection.astro';
import CtaSection from '@/components/home/CtaSection.astro';
import InsightsSection from '@/components/home/InsightsSection.astro';
import { getServices, getLatestNews, getFacilities } from '@/lib/functions';

const [services, posts, facilities] = await Promise.all([
    getServices(6),
    getLatestNews(3),
    getFacilities(6),
]);
---

<BaseLayout
    title="Chrissworld | Unique Solutions, Winning Partnerships"
    description="Chrissworld PLC delivers freight forwarding, warehousing, inland transportation and project cargo handling across Sri Lanka. One partner, from A to Z."
>
    <Header />

    <main id="main-content">
        <Hero serviceCount={services.length} facilityCount={facilities.length} />
        <ServicesSection services={services} />
        <AboutSection />
        <FacilitiesSection facilities={facilities} />
        <TestimonialsSection />
        <CtaSection />
        <InsightsSection posts={posts} />
    </main>

    <Footer />
</BaseLayout>
